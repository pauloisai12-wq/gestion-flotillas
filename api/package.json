{
  "name": "flotillas-api",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:sprint2:unit": "vitest run tests/sprint2",
    "test:sprint2": "npm run test:sprint2:unit && node scripts/test-sprint2-fuel-integrity.js && node scripts/test-sprint2-vehicle-budget.js",
    "test:sprint3": "vitest run tests/sprint3",
    "test:sprint4": "vitest run tests/sprint4",
    "benchmark:sprint3": "node scripts/benchmark-sprint3-data-jobs.js",
    "bootstrap:admin": "node dist/scripts/bootstrap-admin.js",
    "user:create": "node dist/scripts/create-user.js",
    "test:config-refs": "node scripts/check-config-references.js",
    "test:migrations": "node scripts/check-qa-migrations-safe.js && node scripts/check-business-time-migration.js",
    "test:qa-ingest": "node scripts/test-qa-ingest-consistency.js",
    "test:sprint1-security": "node scripts/test-sprint1-security.js && node scripts/test-public-fuel-load-behavior.js",
    "test:uploads": "npm run build && node scripts/test-upload-cleanup.js",
    "qa:device:register": "node dist/scripts/qa-externa-device-register.js",
    "qa:device:revoke": "node dist/scripts/qa-externa-device-revoke.js",
    "qa:reviewer:create": "node dist/scripts/qa-reviewer-create.js"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@prisma/client": "^6.19.3",
    "@react-pdf/renderer": "^4.0.0",
    "@sentry/node": "^10.53.1",
    "@sentry/profiling-node": "^10.53.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.73.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.22.1",
    "file-type": "^22.0.1",
    "helmet": "^8.1.0",
    "image-size": "^1.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.3",
    "react": "^18.3.1",
    "sharp": "^0.35.3",
    "swagger-ui-express": "^5.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.18",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.16.0",
    "@types/react": "^18.3.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.2.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
